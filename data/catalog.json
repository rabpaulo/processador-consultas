  "examples": [
    {
      "name": "Produtos por preço",
      "sql": "SELECT Nome, Preco\nFROM Produto\nWHERE Preco > 200 AND QuantEstoque >= 15;"
    },
    {
      "name": "Produtos e categorias",
      "sql": "SELECT p.Nome, p.Preco, c.Descricao\nFROM Produto AS p\nINNER JOIN Categoria AS c ON p.Categoria_idCategoria = c.idCategoria\nWHERE p.Preco > 200 AND c.Descricao = 'Informática';"
    },
    {
      "name": "Pedidos por cliente",
      "sql": "SELECT c.Nome, p.idPedido, p.ValorTotalPedido, s.Descricao\nFROM Cliente AS c\nINNER JOIN Pedido AS p ON c.idCliente = p.Cliente_idCliente\nINNER JOIN Status AS s ON p.Status_idStatus = s.idStatus\nWHERE p.ValorTotalPedido >= 500 AND s.idStatus = 2;"
    },
    {
      "name": "Junção no WHERE",
      "sql": "SELECT p.Nome, c.Descricao\nFROM Produto AS p, Categoria AS c\nWHERE (p.Categoria_idCategoria = c.idCategoria AND p.Preco < 300);"
    },
    {
      "name": "Campo inválido",
      "sql": "SELECT Nome, Valor\nFROM Produto\nWHERE Preco > 100;"
    }
  ]
